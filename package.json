{
  "name": "dsh-pseudo-insideout",
  "version": "0.0.1",
  "description": "DSH 记忆与状态插件：独立封存、情绪、人格岛与可视化控制台。",
  "type": "module",
  "license": "MIT",
  "main": "./src/dsh/host.js",
  "exports": {
    ".": "./src/dsh/host.js",
    "./client": "./src/dsh/client.js",
    "./core": "./src/core/service.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "web",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node scripts/serve.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "insideout"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2"
  }
}
